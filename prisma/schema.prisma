// AgoraNet v3 — Phase 0 schema. SQLite only, by build law (BUILD_ORDER
// Rule 3): the Postgres track and parity checking arrive at Phase 8.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------
// Identity (Phase A trust model — DUAL_IDENTITY_MODULE.md §10)
//
// In Phase A the platform holds the human↔profile mapping. That link is
// operator-trusted and honestly disclosed (lib/gate.ts carries the
// disclosure). These rows are INTERNAL: their ids are forbidden from the
// public ledger — db:verify scans every event for them and fails loudly.
// ------------------------------------------------------------------

model Human {
  id             String    @id @default(cuid())
  // Interim issuer (Phase A): the soul holds the credential secret (their
  // "wallet"); the platform stores only its hash. Real issuer at Phase 9.
  credentialHash String    @unique
  verifiedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  profiles       Profile[]
}

model Profile {
  id           String        @id @default(cuid())
  // NULL for every Alias — deliberately. One-Alias-per-human is enforced
  // by the alias-registration nullifier spend, never by a stored link;
  // no database row connects a soul's two faces (DUAL_IDENTITY §1.2).
  // The True Self keeps its Human link: recovery routes through the
  // human, and that link never bridges to the Alias.
  humanId      String?
  human        Human?        @relation(fields: [humanId], references: [id])
  face         String // "TRUE_SELF" | "ALIAS"
  // Two-layer naming (owner-ratified 2026-07-10, ONBOARDING Stage 3.4):
  // the @handle is the attribution key — unique across one flat global
  // taken-list (all profiles, both faces, PLUS HandleTombstone), never
  // recycled. Stored lowercase. The display name is free-form: duplicates
  // allowed, real names welcome, changeable behind a rate rail.
  handle       String        @unique
  displayName  String
  displayNameChangedAt DateTime?
  // Per-face login secret, held soul-side, hash stored. Each face signs
  // in with its own key — login never routes through the Human.
  accessKeyHash String       @unique
  // Aliases are born PENDING and activate at a randomized, cohort-batched
  // moment (ONBOARDING §3.3–3.4); True Selves are born active.
  status       String        @default("active") // "active" | "pending"
  activateAt   DateTime?
  // Coarse join period only — never a precise timestamp (§3.5).
  joinedPeriod String
  createdAt    DateTime      @default(now())
  gateRequests GateRequest[]
  valuesAnswers ValuesAnswer[]
  consentAcks  ConsentAck[]

  @@unique([humanId, face])
}

// Handles are never recycled: revocation (hatching), deletion, or
// abandonment tombstones the handle permanently — the permanent record's
// attribution never silently changes owners. The taken-list = live
// handles ∪ tombstones, and records only THAT a string is claimed —
// zero ownership/linkage information.
model HandleTombstone {
  handle        String   @id // lowercase
  reason        String // "hatched" | "deleted" | "abandoned"
  tombstonedAt  DateTime @default(now())
}

// The values seed (ONBOARDING Stage 5): per-profile answers to the seven
// OUSIA questions. Matchmaking-only — the ratified conservative default;
// never rendered publicly (private → public later is a choice, the
// reverse is a breach).
model ValuesAnswer {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id])
  questionId String
  body       String
  createdAt  DateTime @default(now())

  @@unique([profileId, questionId])
}

// Blocking acknowledgments, recorded (ONBOARDING §4): permanence and
// Constitution before the first post; the §3.6 alias disclosures at hatch.
model ConsentAck {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  kind      String // "permanence" | "constitution" | "alias-disclosures"
  version   String
  ackedAt   DateTime @default(now())

  @@unique([profileId, kind])
}

// ------------------------------------------------------------------
// Sessions & the parking rule (SEVEN_PILLAR_DASHBOARD_SPEC §3).
//
// A SoulSession is one browser/device context. It is the ONLY place a
// soul's two faces ever co-occur — which is what lets the backend
// enforce the per-pillar lock without any durable identity link. These
// rows are ephemeral by design: short retention, purged on expiry
// (DUAL_IDENTITY §7.2 — minimal, segregated, short-retention).
// ------------------------------------------------------------------

model SoulSession {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  lastSeenAt      DateTime      @default(now())
  // The face currently selected in this session — explicit and visible,
  // never an ambient default (DASHBOARD §3.3.1).
  activeProfileId String?
  lastSwitchAt    DateTime? // face-switch cooldown anchor
  faces           SessionFace[]
  locks           PillarLock[]
}

model SessionFace {
  sessionId String
  session   SoulSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  profileId String
  addedAt   DateTime    @default(now())

  @@id([sessionId, profileId])
}

// The parking lots: one face per pillar per session, backend-enforced.
model PillarLock {
  sessionId    String
  session      SoulSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pillarId     String
  profileId    String
  lastActiveAt DateTime    @default(now())

  @@id([sessionId, pillarId])
}

// ------------------------------------------------------------------
// The gate (DUAL_IDENTITY_MODULE.md §3.3): pending → proof → cleared.
// Application code never branches on identity — only on clearance.
// ------------------------------------------------------------------

model GateRequest {
  id              String    @id @default(cuid())
  profileId       String
  profile         Profile   @relation(fields: [profileId], references: [id])
  scope           String // e.g. "poll:{id}:face" — namespaces the nullifier
  scopeKind       String // "per-profile" | "per-human" (§4.2 — both from day one)
  // "pseudonymous": clearance lands on the public ledger (the default —
  // civic actions are public record). "private": no public event at all;
  // for actions whose existence must not be observable (flags — the
  // triangle of blindness, MODERATION §3.2: the public sees only
  // outcomes). The gate still enforces humanity + one-per-scope.
  ledgerRecording String    @default("pseudonymous") // "pseudonymous" | "private"
  status          String // "PENDING" | "CLEARED" | "DUPLICATE" | "INVALID"
  nullifier       String? // set when the proof is checked; HMAC output, never a raw id
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
}

// One nullifier may clear a given scope exactly once. The composite key
// IS the one-per-scope enforcement; verify.ts re-checks it independently.
model NullifierSpend {
  scope     String
  nullifier String
  createdAt DateTime @default(now())

  @@id([scope, nullifier])
}

// ------------------------------------------------------------------
// The Civic Ledger — append-only, hash-chained (v2 pattern, reimplemented).
// Nothing edits or deletes rows; corrections are new amendment events.
// Speaks only in pseudonyms and nullifiers — never an internal id.
// ------------------------------------------------------------------

model LedgerEvent {
  seq        Int       @id @default(autoincrement())
  prevHash   String    @unique // entryHash of the previous event ("GENESIS" for seq 1)
  entryHash  String    @unique // sha256(prevHash | eventType | canonical payload)
  actorType  String // "system" | "soul" | "founder" | "moderator"
  actorId    String? // a pseudonym or null — never a Human/Profile db id
  eventType  String // e.g. "genesis", "pillar.seeded", "gate.cleared"
  payload    String // canonical JSON string
  createdAt  DateTime  @default(now())
  anchoredAt DateTime? // Phase 9: when batched to Arweave/Midnight
  anchorRef  String? // Phase 9: tx hash / Arweave id
}

// ------------------------------------------------------------------
// The canon: 7 pillars × 7 lenses = 49 questions (SEVEN_PILLARS.md,
// carried forward from v2 as-is). Seeded from lib/canon.ts.
// ------------------------------------------------------------------

model Pillar {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  classicalName String
  loreName      String
  icon          String
  colorPrimary  String
  colorLight    String
  colorDark     String
  isMeta        Boolean      @default(false)
  position      Int          @unique // 1..7
  questions     Question[]
  discussions   Discussion[]
  polls         Poll[]
}

model Question {
  id         String      @id @default(cuid())
  pillarId   String
  pillar     Pillar      @relation(fields: [pillarId], references: [id])
  lens       String // OUSIA | AITIA | MODUS | PERSONA | VELA | KYOKAI | TAO
  position   Int         @unique // 1..49, one sequence across the whole matrix
  text       String
  discussion Discussion?

  @@unique([pillarId, lens])
}

// ------------------------------------------------------------------
// Rails — every number is data, never a literal (build law; values from
// Economics/ECONOMIC_STARTING_DEFAULTS.md, testing defaults in u).
// Poll-adjustable within bounds when governance arrives (Phase 3+);
// unless a spec says otherwise, bounds are [¼×, 4×] of the default.
// ------------------------------------------------------------------

model Rail {
  key         String @id // e.g. "discussion.replyFee"
  value       Float
  unit        String // "uPC" | "uG" | "minutes" | ...
  boundMin    Float
  boundMax    Float
  description String
}

// ------------------------------------------------------------------
// The rulebook as data (CONTENT_MODERATION_RULEBOOK.md, complete v1).
// Flags cite a rule; rulings (Phase 5) cite a rule. Amendments are
// governance events later — for now the seed is the legislation.
// ------------------------------------------------------------------

model Rule {
  id      String @id // "R1.1" … "R3.8"
  tier    Int // 1 routine | 2 serious | 3 severe
  title   String
  summary String
  flags   Flag[]
}

// ------------------------------------------------------------------
// Discussions (DISCUSSIONS_SPEC.md; Phase 1 scope = the 49 canonical
// threads). Permanence is a property of the SPACE, fixed at creation,
// always visible (§8).
// ------------------------------------------------------------------

model Discussion {
  id         String    @id @default(cuid())
  title      String
  pillarId   String
  pillar     Pillar    @relation(fields: [pillarId], references: [id])
  // Canonical threads map 1:1 onto canon questions (the civic spine).
  questionId String?   @unique
  question   Question? @relation(fields: [questionId], references: [id])
  // Poll-context Discussions (POLLS §4.4): attached at creation or by
  // any soul later; consensus-fail offers one (prompted, never automatic).
  pollId     String?
  poll       Poll?     @relation(fields: [pollId], references: [id])
  // "permanent-canonical" (platform-created, ratified permanent);
  // "permanent-governance" (lives in a pillar's Governance room —
  // everything in that room is permanent record, DISCUSSIONS §8);
  // "deletable" (soul-created context spaces). Paid permanence: Phase 4.
  permanence String
  createdAt  DateTime  @default(now())
  posts      Post[]
}

// ------------------------------------------------------------------
// Polls (POLLS_SPEC.md, fully ratified) — one profile, one vote, no
// weight mechanics of any kind. Sealed-until-close is the platform
// default; governance polls are always sealed and close by candle.
// ------------------------------------------------------------------

model Poll {
  id               String       @id @default(cuid())
  pillarId         String
  pillar           Pillar       @relation(fields: [pillarId], references: [id])
  creatorProfileId String // Phase A operator space — never public
  creatorHandle    String // the attribution key, frozen at creation
  title            String
  description      String?
  type             String // "single" | "multi" | "consensus"
  consensusThreshold Float? // consensus polls: 0.5–1.0, creator-set
  // Vote-visibility mode, stated plainly BEFORE a soul votes (§2):
  // "public" (choice visibly attached, on this poll's page only — no
  // cross-poll dossier is ever compiled) | "pseudonymous" (ballots
  // keyed by nullifier only; aggregate results, never who chose what).
  mode             String
  isGovernance     Boolean      @default(false)
  // Ordinary polls only: creator may show a live tally. Governance
  // polls are always sealed — no option (§4.7).
  liveTally        Boolean      @default(false)
  // Circle-restricted visibility (consumed in Phase 6).
  visibilityScope  String       @default("public") // "public" | "circle"
  circleRef        String?
  createdAt        DateTime     @default(now())
  nominalCloseAt   DateTime
  // The candle (governance): the TRUE close is drawn randomly within
  // the final stretch, committed publicly as sha256(trueCloseAt|salt)
  // in poll.created, revealed with the results. Ordinary polls:
  // trueCloseAt = nominalCloseAt. Hidden fields are Phase A operator
  // space; the commitment makes the reveal verifiable by anyone.
  trueCloseAt      DateTime
  candleSalt       String?
  candleCommitment String?
  status           String       @default("open") // "open" | "closed"
  closedAt         DateTime?
  outcome          String? // "completed" | "passed" | "no-consensus"
  options          PollOption[]
  ballots          Ballot[]
  discussions      Discussion[]
}

model PollOption {
  id       String   @id @default(cuid())
  pollId   String
  poll     Poll     @relation(fields: [pollId], references: [id])
  label    String
  position Int
  // Set once, at close, from counted ballots — never maintained live.
  tally    Int?
  choices  BallotChoice[]

  @@unique([pollId, position])
}

// One ballot per profile per poll, enforced by the gate's nullifier —
// which is also the ballot's key. In PSEUDONYMOUS mode no profile is
// attached, ever (DUAL_IDENTITY §4.3: keyed by nullifier only). In
// PUBLIC mode the voter's handle is attached by design and published
// post-close. `counted` is decided at close by the candle.
model Ballot {
  id          String         @id @default(cuid())
  pollId      String
  poll        Poll           @relation(fields: [pollId], references: [id])
  nullifier   String
  voterProfileId String? // public mode only — Phase A operator space
  voterHandle    String? // public mode only — published post-close
  voterDisplayName String? // public mode only — frozen at cast
  castAt      DateTime       @default(now())
  counted     Boolean?
  choices     BallotChoice[]

  @@unique([pollId, nullifier])
}

model BallotChoice {
  ballotId String
  ballot   Ballot     @relation(fields: [ballotId], references: [id])
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id])

  @@id([ballotId, optionId])
}

model Post {
  id           String         @id @default(cuid())
  discussionId String
  discussion   Discussion     @relation(fields: [discussionId], references: [id])
  parentId     String?
  parent       Post?          @relation("Thread", fields: [parentId], references: [id])
  replies      Post[]         @relation("Thread")
  // The author's internal profile id stays in Phase A operator space;
  // everything public (pages, ledger) speaks the @handle — the eternal
  // attribution key. Permanent-class content freezes the display name
  // as it was at composition (naming ruling 2026-07-10); live surfaces
  // show the current one.
  authorProfileId String
  authorHandle    String
  authorDisplayName String
  body         String
  status       String         @default("visible") // hidden/blur states arrive Phase 5
  createdAt    DateTime       @default(now())
  // Grace window (rail: discussion.graceWindowMinutes): edits allowed
  // with visible history until this moment, then the record locks.
  editableUntil DateTime
  revisions    PostRevision[]
  flagsOn      Flag[]
}

// Visible edit history within the grace window (§8: "typo repair with
// visible edit history, then locked into the record").
model PostRevision {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id])
  body     String // the body as it was BEFORE the edit
  editedAt DateTime @default(now())
}

// ------------------------------------------------------------------
// Flag capture — queue only in Phase 1; adjudication arrives Phase 5.
// A flag's existence is never public (triangle of blindness). The
// reporter's profile id is Phase A operator space (deposit refunds
// need it later); moderators never see it — Phase 5 case files are
// built nullifier-keyed.
// ------------------------------------------------------------------

model Flag {
  id                String   @id @default(cuid())
  postId            String
  post              Post     @relation(fields: [postId], references: [id])
  ruleId            String // which rule is alleged (the case category)
  rule              Rule     @relation(fields: [ruleId], references: [id])
  note              String?
  reporterProfileId String
  nullifier         String // gate nullifier — keys the flag for Phase 5 handling
  status            String   @default("queued")
  createdAt         DateTime @default(now())
}
