# --- Local development (SQLite) ---------------------------------------
DATABASE_URL="file:./dev.db"

# Phase A operator secret for the HMAC nullifier (DUAL_IDENTITY §10).
# Holding this secret is exactly the operator trust the Phase A disclosure
# describes; it is retired at Phase C. Generate: openssl rand -hex 32
GATE_OPERATOR_SECRET="replace-me-with-a-real-secret"

# Phase A DM key escrow secret (FELLOW_SOULS §9.1 resolution; the same
# trust posture as the gate, disclosed in the thread UI).
# Generate: openssl rand -hex 32
DM_MASTER_SECRET="replace-me-with-a-real-secret"

# Rate-limit key hashing (Phase 8): identifiers are HMAC-hashed before
# storage so raw addresses never persist (DUAL_IDENTITY §7.1 vector 4).
# Generate: openssl rand -hex 32
RATE_LIMIT_SECRET="replace-me-with-a-real-secret"

# --- Hosted environments (staging/production, Postgres) ----------------
# The runtime guard (lib/runtimeConfig.ts) refuses to boot a hosted
# environment unless ALL of the following are set for real:
#
# DEPLOYMENT_ENV="staging"                # or "production"
# DATABASE_URL="postgresql://..."         # pooled runtime connection
# DIRECT_DATABASE_URL="postgresql://..."  # optional non-pooled connection;
#                                         # preferred for migrations/backups
# TRUST_PROXY="true"                      # behind the host's proxy,
#                                         # x-forwarded-for is trustworthy
# GATE_OPERATOR_SECRET / DM_MASTER_SECRET / RATE_LIMIT_SECRET:
#   32+ chars, generated, never placeholders.

# --- Phase 8.6 Testnet Rails (TESTNET_RAILS_SPEC §6.1) ---
# Cardano testnet selector; the app refuses mainnet values by design.
CARDANO_NETWORK="preprod"
# Free Blockfrost API key, PREPROD project (owner-held, never committed).
BLOCKFROST_PROJECT_ID=""
