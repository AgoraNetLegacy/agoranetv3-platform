# --- Local development (SQLite) ---------------------------------------
DATABASE_URL="file:./dev.db"

# Phase A operator secret for the HMAC nullifier (DUAL_IDENTITY §10).
# Holding this secret is exactly the operator trust the Phase A disclosure
# describes; it is retired at Phase C. Generate: openssl rand -hex 32
GATE_OPERATOR_SECRET="replace-me-with-a-real-secret"

# Phase A DM key escrow secret (FELLOW_SOULS §9.1 resolution; the same
# trust posture as the gate, disclosed in the thread UI).
# Generate: openssl rand -hex 32
DM_MASTER_SECRET="replace-me-with-a-real-secret"

# Rate-limit key hashing (Phase 8): identifiers are HMAC-hashed before
# storage so raw addresses never persist (DUAL_IDENTITY §7.1 vector 4).
# Generate: openssl rand -hex 32
RATE_LIMIT_SECRET="replace-me-with-a-real-secret"

# --- Hosted environments (staging/production, Postgres) ----------------
# The runtime guard (lib/runtimeConfig.ts) refuses to boot a hosted
# environment unless ALL of the following are set for real:
#
# DEPLOYMENT_ENV="staging"                # or "production"
# DATABASE_URL="postgresql://..."         # pooled runtime connection
# DIRECT_DATABASE_URL="postgresql://..."  # optional non-pooled connection;
#                                         # preferred for migrations/backups
# TRUST_PROXY="true"                      # behind the host's proxy,
#                                         # x-forwarded-for is trustworthy
# GATE_OPERATOR_SECRET / DM_MASTER_SECRET / RATE_LIMIT_SECRET:
#   32+ chars, generated, never placeholders.

# --- Anti-bot layer -----------------------------------------------------
# Turnstile is anti-bot protection, not proof of humanity or uniqueness.
# Set these in staging/production after creating a Cloudflare Turnstile widget.
TURNSTILE_ENABLED="false"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Registration and governance checks are always enforced. Timed active-user
# refreshes are a separate future policy and will get their own documented
# cadence rather than reusing a registration setting.

# --- Public Chamber covers ---------------------------------------------
# Vercel Blob injects its read/write token when the public store is connected.
# Keep the feature flag false until the Railway metadata migration is applied
# and verified; existing storefronts continue to render without either value.
BLOB_READ_WRITE_TOKEN=""
CHAMBER_COVERS_ENABLED="false"

# --- Grounded Helpdesk --------------------------------------------------
# Optional. Without a configured provider, Support still searches approved
# articles and creates human-support cases; only generation is disabled.
# Local Gemma 4 E4B development lane (ModernClaw/llama.cpp, loopback only):
HELPDESK_PROVIDER="disabled"             # disabled | llama_cpp | openai
HELPDESK_BASE_URL="http://127.0.0.1:8080/v1"
HELPDESK_MODEL="google/gemma-4-e4b"
HELPDESK_API_KEY=""                      # required for protected/hosted endpoints
HELPDESK_TIMEOUT_MS="45000"
HELPDESK_MAX_OUTPUT_TOKENS="700"          # local Gemma; hosted default is 450
# Legacy hosted-provider compatibility. Prefer HELPDESK_* for new setups.
OPENAI_API_KEY=""
OPENAI_HELPDESK_MODEL="gpt-5.4-mini"

# --- Phase 8.6 Testnet Rails (TESTNET_RAILS_SPEC §6.1) ---
# Cardano testnet selector; the app refuses mainnet values by design.
CARDANO_NETWORK="preprod"
# Free Blockfrost API key, PREPROD project (owner-held, never committed).
BLOCKFROST_PROJECT_ID=""

# Throwaway PREPROD minting key (Phase 8.6 — generated per environment, TESTNET ONLY).
TESTNET_MINT_MNEMONIC=""
# Filled once the test asset is minted (§6.1) — the throwaway demo policy.
TEST_POLLCOIN_POLICY_ID=""

# On-chain migration Slice 3 (ONCHAIN_ECONOMY_MIGRATION.md): who may
# collect the demo donation lock after its deadline — the dev script
# wallet's ADDRESS (public by nature, not a key; `npx tsx
# scripts/chain/addr.ts` prints it). Config so the demo beneficiary can
# be rotated; Track 2 replaces the single beneficiary with M-of-N.
TESTNET_DEMO_BENEFICIARY_ADDR=""

# Midnight testnet selector (§6.1) — "preview", "preprod", or "undeployed"
# (local standalone). The exercise harness refuses mainnet values by design.
MIDNIGHT_NETWORK="preview"
# Local dev proof server (infra/midnight/docker-compose.yml) — dev-grade
# proving by ratified scope; 20–60s per proof is normal.
MIDNIGHT_PROOF_SERVER_URL="http://localhost:6300"
# Throwaway deploy-wallet seed, 64 hex chars (openssl rand -hex 32) — TESTNET ONLY.
MIDNIGHT_DEPLOY_SEED=""
# The demo's stable subject commitment (§1.5), 64 hex chars — the witness secret.
MIDNIGHT_SUBJECT_COMMITMENT=""
# Filled once the nullifier contract is deployed (infra/midnight/exercise.ts).
MIDNIGHT_NULLIFIER_CONTRACT=""
